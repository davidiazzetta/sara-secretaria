# ============================================================
#  SARA — Variáveis de ambiente (copie para um arquivo .env)
# ============================================================

# --- Servidor ---
PORT=3000
# Token secreto que você inventa. O Kommo enviará esse token para
# provar que a chamada veio mesmo do Kommo (e não de um estranho).
WEBHOOK_SECRET=troque-por-um-segredo-forte

# --- Cérebro da Sara: Claude (Anthropic) ---
# Pegue sua chave em https://console.anthropic.com/ (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo. Para um chatbot de atendimento em português, o Sonnet 5 é o
# melhor custo/qualidade. Use claude-opus-5 se quiser a máxima qualidade.
SARA_MODEL=claude-sonnet-5

# --- Kommo (central de canais: WhatsApp, Instagram, Facebook, Messenger) ---
# Subdomínio da sua conta Kommo. Ex.: se sua conta é
# https://drdavid.kommo.com, então KOMMO_SUBDOMAIN=drdavid
KOMMO_SUBDOMAIN=suaconta
# Token de acesso de longa duração da integração privada do Kommo.
# (Kommo > Configurações > Integrações > criar integração > "chave de acesso de longa duração")
KOMMO_ACCESS_TOKEN=eyJ0xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID do funil (pipeline) onde os leads da Sara devem cair.
KOMMO_PIPELINE_ID=0
# IDs dos estágios do funil (veja docs/SETUP-KOMMO.md para descobrir).
KOMMO_STAGE_NOVO_LEAD=0
KOMMO_STAGE_QUALIFICADO=0
KOMMO_STAGE_AGENDADO=0

# --- Google Agenda (agendamento das consultas) ---
# Baixe o JSON de credenciais OAuth em https://console.cloud.google.com/
# (APIs e serviços > Credenciais). Cole os valores abaixo.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# ID da agenda do Dr. David (normalmente o e-mail da conta, ou "primary").
GOOGLE_CALENDAR_ID=primary
# (Opcional — só para HOSPEDAGEM) Cole aqui o JSON do token que aparece na tela
# após autorizar o Google. Faz o acesso à agenda sobreviver aos deploys.
# Em uso local, deixe em branco.
GOOGLE_TOKEN_JSON=
